# Sample of the root .env for local development.
#   cp samples/.env.local .env   # one-time, then edit
#
# docker compose injects this file into the containers as real environment
# variables (`env_file: .env`). The application reads its entire configuration
# from these variables — there are no .env files inside app/.

APP_ENV=dev
# Symfony framework secret (CSRF tokens, signed URIs). Use a strong random value
# per environment, e.g.: php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
APP_SECRET=da9cdcf4e32d24732c6282fe09059c1d

###> database (Doctrine builds the DSN from these parts; matches the db service) ###
APP_DB=app
APP_DB_HOST=db
APP_DB_PORT=3306
APP_DB_USER=app
APP_DB_PASSWORD=app
###< database ###

###> binance ###
# Public market-data endpoints (ticker price) need no credentials; leave empty.
BINANCE_API_KEY=
BINANCE_API_SECRET=
###< binance ###

###> api signing ###
# Private Ed25519 signing key (hex-encoded 32-byte seed) used to sign every API
# response (the envelope's `security.signature`). Clients verify with the matching
# PUBLIC key — keep this private. This is a dev-only keypair; generate your own per
# environment:
#   php -r '$kp=sodium_crypto_sign_keypair();
#           echo "private=", sodium_bin2hex(substr(sodium_crypto_sign_secretkey($kp),0,32)), PHP_EOL;
#           echo "public =", sodium_bin2hex(sodium_crypto_sign_publickey($kp)), PHP_EOL;'
# Public key for the seed below: a9cd5b5fd3ff6233e597451451bc6c3d428946078608bdf5ee9f8e8772bf9810
API_SIGNING_PRIVATE_KEY=6effdd47ad2e689e58d797884cf56835731a3a6cabbac5ab2fed7b8a42c9028c
# Names the key in the signature so it can be rotated without breaking clients.
API_SIGNING_KEY_ID=v1
###< api signing ###
